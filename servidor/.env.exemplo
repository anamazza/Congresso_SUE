# =====================================================================
# Configuração do servidor do simpósio. Copie este arquivo para
# servidor/.env, preencha e não publique o .env (ele tem a senha do SMTP).
# Linhas começando com # são comentários.
# =====================================================================

# Endereço público do site, com a barra no final. Vai nos e-mails
# (link da área do inscrito e dos convites da comissão).
URL_SITE=https://diid.subhue.org/static-html/congresso-sue/

# E-mails de quem entra na área da organização, separados por vírgula.
# No primeiro acesso, a pessoa usa "Esqueci a senha / primeiro acesso"
# na página Entrar e cria a senha com o código que chega por e-mail.
ORGANIZACAO_EMAILS=

# Se o proxy do DIID repassa o caminho inteiro (ex.: /static-html/congresso-sue/api),
# informe o prefixo aqui. Se o proxy já tira o prefixo, deixe vazio.
CAMINHO_BASE=

# Porta dentro do contêiner (o docker-compose publica a 8080)
PORTA=8080

# ---------------------------------------------------------------------
# E-mail
#   smtp     = envia pelo servidor de e-mail (preencha SMTP_*)
#   arquivo  = não envia; grava cada e-mail em /dados/emails.log
#              (útil para conferir a instalação antes de ligar o SMTP)
#   desligado = não envia nem grava
# Se EMAIL_MODO ficar vazio, usa smtp quando SMTP_HOST estiver preenchido.
# ---------------------------------------------------------------------
EMAIL_MODO=
SMTP_HOST=
SMTP_PORTA=587
# true para a porta 465 (SSL direto); false para 587 (STARTTLS)
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
# Quem aparece como remetente, ex.: Simpósio UE <simposio@exemplo.rio>
EMAIL_REMETENTE=
# Para onde vão as respostas dos participantes (opcional)
EMAIL_RESPOSTA=

# ---------------------------------------------------------------------
# Prazos (datas no formato AAAA-MM-DD, horário de Brasília).
# Deixe vazio para usar os do edital, que já estão no programa.
# ---------------------------------------------------------------------
INSCRICOES_INICIO=
INSCRICOES_FIM=
# Número máximo de inscrições; 0 ou vazio = sem limite
VAGAS=
SUBMISSAO_INICIO=
SUBMISSAO_FIM=
# Data do resultado como aparece no e-mail, ex.: 16/11/2026
RESULTADO=

# true num servidor de homologação: os e-mails saem com [TESTE] no assunto
TESTE=false

# Só se o site ficar num endereço e a API em outro (normalmente vazio)
ORIGENS_PERMITIDAS=
